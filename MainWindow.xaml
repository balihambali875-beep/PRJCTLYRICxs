<Window x:Class="LyricPop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lyric Pop" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Window.Resources>
        <!-- Ikon dari font sistem Segoe Fluent Icons / Segoe MDL2 Assets -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="bg" Fill="{TemplateBinding Background}"/>
                            <Ellipse x:Name="hover" Fill="{TemplateBinding Foreground}" Opacity="0"/>
                            <Ellipse Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{Binding BorderThickness.Left, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="20" Width="340" CornerRadius="32" BorderThickness="1.5" Opacity="0"
            RenderTransformOrigin="0.5,0">
        <Border.Effect>
            <DropShadowEffect x:Name="Glow" BlurRadius="30" ShadowDepth="0" Opacity="0.55" Color="#B35CFF"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"/>
                <TranslateTransform x:Name="RootShift" Y="-18"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid>
            <!-- ===== COMPACT (mouse tidak diarahkan) ===== -->
            <Grid x:Name="CompactView" Margin="10,9,18,9" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ArtSmall" Grid.Column="0" Width="46" Height="46" CornerRadius="12"/>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleSmall" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistSmall" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="LyricSmall" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel x:Name="Wave" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Height="30"/>
            </Grid>

            <!-- ===== EXPANDED (mouse diarahkan) ===== -->
            <Grid x:Name="ExpandedView" Margin="26,24,26,22" Visibility="Collapsed" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border x:Name="ArtBig" Width="190" Height="190" CornerRadius="18" HorizontalAlignment="Left">
                        <TextBlock x:Name="ArtNote" Text="&#9834;" FontSize="48" Foreground="#E6FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleBig" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistBig" FontSize="11" Margin="0,3,0,12" TextTrimming="CharacterEllipsis"/>

                    <Grid x:Name="Bar" Height="14" Background="Transparent" Cursor="Hand">
                        <Border x:Name="BarTrack" Height="4" CornerRadius="2" VerticalAlignment="Center"/>
                        <Border x:Name="BarFill" Height="4" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <Grid Margin="0,2,0,6">
                        <TextBlock x:Name="CurText" FontSize="10.5" Text="0:00" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="DurText" FontSize="10.5" Text="--:--" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnShuffle" Grid.Column="0" Style="{StaticResource IconBtn}" ToolTip="Acak">
                            <TextBlock x:Name="ShuffleIcon" Style="{StaticResource Glyph}" Text="&#xE8B1;" FontSize="14"/>
                        </Button>
                        <Button x:Name="BtnPrev" Grid.Column="1" Style="{StaticResource IconBtn}" ToolTip="Sebelumnya">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;"/>
                        </Button>
                        <Button x:Name="BtnPlay" Grid.Column="2" Style="{StaticResource IconBtn}" ToolTip="Putar / jeda"
                                Width="40" Height="40" BorderThickness="1.5">
                            <TextBlock x:Name="PlayIcon" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="16"/>
                        </Button>
                        <Button x:Name="BtnNext" Grid.Column="3" Style="{StaticResource IconBtn}" ToolTip="Berikutnya">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;"/>
                        </Button>
                        <Button x:Name="BtnRepeat" Grid.Column="4" Style="{StaticResource IconBtn}" ToolTip="Ulangi">
                            <TextBlock x:Name="RepeatIcon" Style="{StaticResource Glyph}" Text="&#xE8EE;" FontSize="14"/>
                        </Button>
                    </Grid>
                </StackPanel>

                <Border x:Name="Divider" Grid.Column="1" Width="1" Margin="22,4,0,4"/>

                <Grid Grid.Column="2" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="290">
                        <Rectangle x:Name="ActiveBar" Width="3" Height="26" RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="0.18"/>
                                    <GradientStop Color="#FF000000" Offset="0.82"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </ScrollViewer.OpacityMask>
                            <StackPanel x:Name="Lines" Margin="16,130"/>
                        </ScrollViewer>
                        <TextBlock x:Name="StateText" Visibility="Collapsed" TextAlignment="Left" TextWrapping="Wrap"
                                   FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SrcText" Grid.Column="0" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ManualLink" Grid.Column="1" FontSize="10.5" Cursor="Hand" TextDecorations="Underline"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- pojok kanan atas: pengaturan + tutup -->
                <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-16,-16,0">
                    <Button x:Name="BtnGear" Style="{StaticResource IconBtn}" Width="30" Height="30" ToolTip="Pengaturan">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="13"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource IconBtn}" Width="30" Height="30"
                            ToolTip="Tutup (muncul lagi saat lagu berganti)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
